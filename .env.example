# Public site URL (used by the landing page metadata).
NEXT_PUBLIC_SITE_URL=https://eventossofi.example

# SQLite database file. Uploaded photos always live in ./data/uploads.
DATABASE_PATH=./data/sofi.db

# First admin account. Only used when the users table is empty; the account is
# created when the server starts. Password: at least 10 characters. You can
# remove these after the first start and change the password in Ajustes.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Meta Pixel + Conversions API. Leave empty to disable tracking.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Only while testing in Events Manager > Test events.
META_TEST_EVENT_CODE=
# Meta Business domain verification code (Business Settings > Brand safety > Domains, meta-tag method).
META_DOMAIN_VERIFICATION=
