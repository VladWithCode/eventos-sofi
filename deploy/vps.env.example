# Copy to deploy/vps.env (git-ignored) and fill in. Read by deploy/vps.sh.
# Plain KEY=value lines, taken literally: "$" and spaces are safe, quotes are optional,
# and a "#" after a value is part of the value (put comments on their own line).

# SSH target (user@host, or a Host alias from ~/.ssh/config) and the folder for the site.
DEPLOY_SSH=user@your-vps
DEPLOY_DIR=/home/user/eventos-sofi
# Public address of the site, with https and no trailing slash.
DEPLOY_URL=https://eventossofi.example

# Port the app listens on (loopback only); point nginx at it.
DEPLOY_PORT=3020
DEPLOY_PM2_NAME=eventos-sofi

# Admin account for the server (password: 10+ characters). It is created only when the server
# database has no users: on the first --code-only deploy, or on any full deploy (which then
# leaves the local accounts out). Later, change the password in Ajustes; these lines are ignored.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Meta Pixel + Conversions API. Leave empty to deploy with tracking off.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Only while testing in Events Manager > Test events.
META_TEST_EVENT_CODE=
# Business Settings > Brand safety > Domains, meta-tag method.
META_DOMAIN_VERIFICATION=
